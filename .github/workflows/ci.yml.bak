name: "Terraform CI/CD"

on:
  push:
    branches: [main]
    paths:
      - "backend-config/**"
      - "bootstrap-gitops/**"
      - "environments/**"
      - "modules/**"
      - ".github/workflows/ci.yml"
      - ".github/workflows/tflint.hcl"

  pull_request:
    branches: [main]
    paths:
      - "backend-config/**"
      - "bootstrap-gitops/**"
      - "environments/**"
      - "modules/**"

  workflow_dispatch:
    inputs:
      action:
        description: "plan | apply | destroy-staging"
        required: true
        default: "plan"
        type: choice
        options: [plan, apply, destroy-staging]

# ─────────────────────────────────────────────────────────────
# IMPORTANT : un seul workflow Terraform tourne à la fois
# Evite les corruptions de state en cas de push simultanés
# ─────────────────────────────────────────────────────────────
concurrency:
  group: terraform-${{ github.ref }}
  cancel-in-progress: false   # Ne jamais annuler un apply en cours

permissions:
  contents: read
  id-token: write        # Requis pour OIDC GCP
  pull-requests: write   # Requis pour commenter le plan sur la PR

env:
  TF_VERSION: "1.7.5"
  TF_IN_AUTOMATION: "true"
  TF_INPUT: "false"
  # TF_CLI_ARGS: "-no-color"
  # Chemins des stacks Terraform
  TF_STAGING_DIR: "environments/staging"
  TF_BOOTSTRAP_DIR: "bootstrap-gitops"

# =============================================================
# JOB 1 — VALIDATION
# Objectif : détecter les problèmes AVANT de toucher GCP
# Tourne sur PR et sur push main
# =============================================================
jobs:
  validate:
    name: "Validate"
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      # ── Vérification du format ────────────────────────────
      # terraform fmt ne corrige pas, il vérifie seulement.
      # Si un fichier n'est pas formaté → le pipeline échoue.
      # Cela force les développeurs à toujours formatter leur code.
      - name: Check Terraform formatting
        run: terraform fmt -check -recursive

      # ── Validation syntaxique par module ─────────────────
      # terraform validate vérifie la syntaxe HCL et les types.
      # -backend=false évite d'avoir besoin des credentials GCP
      # pour valider la syntaxe uniquement.
      - name: Validate Terraform modules
        run: |
          for d in backend-config environments/staging bootstrap-gitops modules/gke modules/networking modules/artifact_registry modules/argocd; do
            [ -d "$d" ] || continue
            echo "──────────────────────────────────────"
            echo "Validating: $d"
            echo "──────────────────────────────────────"
            (cd "$d" && \
              terraform init -backend=false -input=false -upgrade && \
              terraform validate)
          done

      # ── tflint : règles de bonnes pratiques ──────────────
      # tflint détecte des problèmes que terraform validate
      # ne détecte pas : variables inutilisées, types incorrects,
      # dépréciations, règles spécifiques au provider GCP.
      - name: Setup tflint
        uses: terraform-linters/setup-tflint@v4
        with:
          tflint_version: v0.50.3

      - name: Init tflint plugins
        run: tflint --init

      - name: Run tflint
        run: tflint --recursive --format compact || true
        # tflint retourne un code d'erreur si des problèmes sont trouvés,

      # ── checkov : scan sécurité IaC ───────────────────────
      # checkov analyse tes fichiers Terraform et détecte des
      # problèmes de sécurité AVANT de créer quoi que ce soit
      # sur GCP. Ex: cluster sans réseau privé, bucket public,
      # SA avec trop de permissions, etc.
      - name: Run Checkov (IaC Security Scan)
        uses: bridgecrewio/checkov-action@master
        with:
          directory: .
          framework: terraform
          output_format: cli
          # Soft fail = le pipeline continue même si checkov trouve
          # des problèmes, mais les résultats sont visibles.
          # Pour un PFE, soft_fail=true est acceptable.
          # En production, on mettrait soft_fail=false.
          soft_fail: true
          skip_check: CKV_GCP_25,CKV_GCP_71
          # CKV_GCP_25 : master auth désactivé (normal sur GKE moderne)
          # CKV_GCP_71 : shielded nodes (coût supplémentaire)

# =============================================================
# JOB 2 — PLAN PHASE A (Staging Infrastructure)
# Objectif : calculer les changements sans les appliquer
# Tourne sur PR ET sur push main
# =============================================================
  plan-phase-a:
    name: "Plan — Phase A (Infra)"
    needs: validate
    runs-on: ubuntu-latest
    # Ne pas tourner sur les PRs de forks (pas d'accès aux secrets)
    if: |
      github.event_name != 'pull_request' ||
      github.event.pull_request.head.repo.fork == false

    defaults:
      run:
        working-directory: ${{ env.TF_STAGING_DIR }}

    outputs:
      # Transmet le code de sortie au job apply
      # 0 = pas de changement, 1 = erreur, 2 = changements détectés
      exitcode: ${{ steps.plan.outputs.exitcode }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      # ── Authentification GCP via OIDC ────────────────────
      # Pas de clé JSON stockée dans les secrets.
      # GitHub Actions prouve son identité à GCP via un token JWT.
      # GCP vérifie que le token vient bien de ce repo GitHub.
      # C'est la méthode la plus sécurisée pour CI/CD.
      - name: Authenticate to GCP (OIDC)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}

      - name: Setup gcloud CLI
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: ${{ vars.GCP_PROJECT_ID }}


  detect-drift:
    name: "Detect infrastructure drift"
    needs: validate
    runs-on: ubuntu-latest
    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.fork == false
    defaults:
      run:
        working-directory: ${{ env.TF_STAGING_DIR }}
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}
      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}
      - uses: google-github-actions/setup-gcloud@v2
      
      - name: Create terraform.tfvars
        run: |
          cat > terraform.tfvars <<EOF
          project_id    = "${{ vars.GCP_PROJECT_ID }}"
          cluster_name  = "${{ vars.GKE_CLUSTER_NAME }}"
          registry_name = "${{ vars.GAR_REPOSITORY_NAME }}"
          region        = "${{ vars.GCP_REGION }}"
          EOF
      
      - name: Terraform Init
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=staging" \
            -reconfigure -input=false
      
      - name: Detect state drift (refresh-only)
        id: drift
        shell: bash
        run: |
          set +e
          terraform plan -refresh-only -detailed-exitcode -no-color 2>&1
          DRIFT=$?
          echo "drift_exitcode=${DRIFT}" >> "$GITHUB_OUTPUT"
          if [ $DRIFT -eq 2 ]; then
            echo "::warning::DRIFT DETECTED — GCP state differs from tfstate"
          fi
          exit 0
      
      - name: Report drift status
        run: |
          echo "Drift exit code: ${{ steps.drift.outputs.drift_exitcode }}"
          echo "0=in-sync, 2=drift-detected, 1=error"

      

      # - name: Terraform Init
      #   run: |
      #     terraform init \
      #       -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
      #       -backend-config="prefix=staging" \
      #       -reconfigure \
      #       -input=false

      # ── Terraform Plan ────────────────────────────────────
      # -out=tfplan.binary : sauvegarde le plan en fichier binaire
      # -detailed-exitcode : retourne 2 si des changements existent
      # On capture le code de sortie MANUELLEMENT avec set +e
      # car GitHub Actions traite tout code != 0 comme une erreur

      # - name: Create terraform.tfvars
      #   run: |
      #     cat > terraform.tfvars <<EOF
      #     project_id    = "${{ vars.GCP_PROJECT_ID }}"
      #     cluster_name  = "${{ vars.GKE_CLUSTER_NAME }}"
      #     registry_name = "${{ vars.GAR_REPOSITORY_NAME }}"
      #     region        = "${{ vars.GCP_REGION }}"
      #     EOF
 
      - name: Terraform Plan
        id: plan
        shell: bash
        run: |
          set +e
          
          terraform plan \
            -no-color \
            -out=tfplan.binary \
            -detailed-exitcode \
            -input=false
          
          EXIT=$?
          echo "exitcode=${EXIT}" >> "$GITHUB_OUTPUT"
          
          # Exit 1 = erreur Terraform réelle → fail le job
          # Exit 2 = changements détectés → succès du job (apply gérera)
          # Exit 0 = aucun changement → succès du job (apply sera skippé normalement)
          if [ "${EXIT}" -eq 1 ]; then
            echo "Terraform plan failed with error" >&2
            exit 1
          fi
          
          echo "Plan exit code: ${EXIT} (0=no-change, 2=changes-detected)"
          exit 0  # ← correct, exit 0 pour 0 et 2
      
      - name: Terraform Plan Summary
        if: always()
        shell: bash
        run: |
          echo "=== PLAN EXIT CODE: ${{ steps.plan.outputs.exitcode }} ==="
          case "${{ steps.plan.outputs.exitcode }}" in
            0) echo "No infrastructure changes detected. Apply will be skipped." ;;
            2) echo "Changes detected. Apply will run." ;;
            *) echo "Unexpected exit code." ;;
          esac
          
          # Force drift detection - always show what terraform sees
          terraform show -json tfplan.binary 2>/dev/null | \
            python3 -c "
          import json,sys
          d=json.load(sys.stdin)
          changes=[r for r in d.get('resource_changes',[]) if r['change']['actions']!=['no-op']]
          print(f'Resources changing: {len(changes)}')
          for r in changes[:10]:
              print(f'  {r[\"change\"][\"actions\"]} {r[\"address\"]}')
          " || echo "Could not parse plan JSON"
              





      # ── Conversion plan en JSON lisible ──────────────────
      # tfplan.binary est un fichier binaire illisible.
      # On le convertit en JSON pour l'afficher dans la PR
      # et pour que d'autres outils puissent l'analyser.
      - name: Convert plan to JSON (for PR comment)
        if: steps.plan.outputs.exitcode == '2'
        run: terraform show -json tfplan.binary > tfplan.json

      # ── Sauvegarde du plan comme artifact ────────────────
      # CRITIQUE : le plan binaire est uploadé ici et sera
      # TÉLÉCHARGÉ dans le job apply-phase-a.
      # Cela garantit que l'apply exécute EXACTEMENT ce plan,
      # pas un nouveau plan recalculé au moment de l'apply.
      - name: Upload plan artifact
        if: steps.plan.outputs.exitcode == '2'
        uses: actions/upload-artifact@v4
        with:
          name: tfplan-phase-a
          path: |
            ${{ env.TF_STAGING_DIR }}/tfplan.binary
            ${{ env.TF_STAGING_DIR }}/tfplan.json
          retention-days: 1  # Plan valide seulement 24h pour sécurité

      # ── Commentaire automatique sur la PR ─────────────────
      # Si c'est une PR, on affiche le résumé du plan directement
      # dans les commentaires GitHub. Le reviewer voit les
      # changements Terraform sans avoir à regarder les logs CI.
      - name: Comment plan on PR
        if: |
          github.event_name == 'pull_request' &&
          steps.plan.outputs.exitcode == '2'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let planJson = {};
            try {
              planJson = JSON.parse(fs.readFileSync(
                '${{ env.TF_STAGING_DIR }}/tfplan.json', 'utf8'
              ));
            } catch(e) {}

            const changes = planJson.resource_changes || [];
            const toAdd = changes.filter(r => r.change.actions.includes('create')).length;
            const toChange = changes.filter(r => r.change.actions.includes('update')).length;
            const toDestroy = changes.filter(r => r.change.actions.includes('delete')).length;

            const body = `## 📋 Terraform Plan — Phase A (Infra)

            | Action | Count |
            |--------|-------|
            | Create | ${toAdd} |
            |  Update | ${toChange} |
            | Destroy | ${toDestroy} |

            > Plan généré pour le commit \`${{ github.sha }}\`
            > L'apply ne sera déclenché qu'après merge sur \`main\`.

            <details>
            <summary>Voir le détail des ressources</summary>

            ${changes.map(r => `- \`${r.change.actions.join('/')}\` **${r.address}**`).join('\n')}
            </details>`;

            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: body
            });

# =============================================================
# JOB 3 — APPLY PHASE A
# Objectif : appliquer le plan sauvegardé (jamais un nouveau plan)
# Tourne UNIQUEMENT sur push main ou workflow_dispatch apply
# =============================================================
  apply-phase-a:
    name: "Apply — Phase A (Infra)"
    needs: plan-phase-a
    runs-on: ubuntu-latest

    # CONDITIONS STRICTES pour l'apply :
    # 1. Le plan a détecté des changements (exitcode == 2)
    # 2. On est sur un push main OU un dispatch manuel avec action=apply
    # 3. JAMAIS sur une PR
    if: |
      needs.plan-phase-a.outputs.exitcode == '2' &&
      github.event_name != 'pull_request' &&
      (
        github.event_name == 'push' ||
        (github.event_name == 'workflow_dispatch' && inputs.action == 'apply')
      )

    defaults:
      run:
        working-directory: ${{ env.TF_STAGING_DIR }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Authenticate to GCP (OIDC)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}

      - name: Setup gcloud CLI
        uses: google-github-actions/setup-gcloud@v2
        with:
          project_id: ${{ vars.GCP_PROJECT_ID }}

      - name: Terraform Init
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=staging" \
            -reconfigure \
            -input=false

      # ── Téléchargement du plan sauvegardé ─────────────────
      # On télécharge le plan EXACTEMENT généré dans plan-phase-a.
      # On n'en génère PAS un nouveau.
      # Cela évite le cas où l'infrastructure change entre le plan
      # et l'apply (ex: quelqu'un a modifié manuellement sur GCP).
      - name: Create terraform.tfvars
        run: |
          cat > terraform.tfvars <<EOF
          project_id    = "${{ vars.GCP_PROJECT_ID }}"
          cluster_name  = "${{ vars.GKE_CLUSTER_NAME }}"
          registry_name = "${{ vars.GAR_REPOSITORY_NAME }}"
          region        = "${{ vars.GCP_REGION }}"
          EOF
 
      - name: Download plan artifact
        uses: actions/download-artifact@v4
        with:
          name: tfplan-phase-a
          path: ${{ env.TF_STAGING_DIR }}

      # ── Apply du plan téléchargé ──────────────────────────
      - name: Terraform Apply
        run: terraform apply -auto-approve tfplan.binary

# =============================================================
# JOB 4 — PLAN PHASE B (GitOps Bootstrap)
# Tourne après apply-phase-a réussi
# =============================================================
  plan-phase-b:
    name: "Plan — Phase B (GitOps)"
    needs: apply-phase-a
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: ${{ env.TF_BOOTSTRAP_DIR }}

    outputs:
      exitcode: ${{ steps.plan.outputs.exitcode }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Authenticate to GCP (OIDC)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}

      # ── Récupération des credentials GKE ─────────────────
      # La phase B déploie des ressources Kubernetes (ArgoCD Application).
      # Elle a besoin de parler à l'API server du cluster GKE.
      # gcloud récupère automatiquement les credentials et les
      # place dans ~/.kube/config pour kubectl et le provider Terraform.
      - name: Get GKE credentials
        run: |
          gcloud container clusters get-credentials \
            ${{ vars.GKE_CLUSTER_NAME }} \
            --region ${{ vars.GCP_REGION }} \
            --project ${{ vars.GCP_PROJECT_ID }}


      - name: Create terraform.tfvars
        run: |
          cat > terraform.tfvars <<EOF
          project_id             = "${{ vars.GCP_PROJECT_ID }}"
          region                 = "${{ vars.GCP_REGION }}"
          cluster_name           = "${{ vars.GKE_CLUSTER_NAME }}"
          gitops_repo_url        = "${{ vars.GITOPS_REPO_URL }}"
          gitops_target_revision = "main"
          gitops_path            = "apps/"
          EOF       

      - name: Terraform Init
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=bootstrap" \
            -reconfigure \
            -input=false

      - name: Terraform Plan
        id: plan
        run: |
          set +e
          terraform plan \
            -out=tfplan.binary \
            -detailed-exitcode \
            -input=false
          EXITCODE=$?
          echo "exitcode=${EXITCODE}" >> $GITHUB_OUTPUT
          echo ">>> Plan exit code: ${EXITCODE}"
          if [ $EXITCODE -eq 1 ]; then exit 1; fi
          exit 0

      - name: Upload plan artifact
        if: steps.plan.outputs.exitcode == '2'
        uses: actions/upload-artifact@v4
        with:
          name: tfplan-phase-b
          path: ${{ env.TF_BOOTSTRAP_DIR }}/tfplan.binary
          retention-days: 1

# =============================================================
# JOB 5 — APPLY PHASE B
# =============================================================
  apply-phase-b:
    name: "Apply — Phase B (GitOps)"
    needs: plan-phase-b
    runs-on: ubuntu-latest

    if: |
      needs.plan-phase-b.outputs.exitcode == '2' &&
      github.event_name != 'pull_request'

    defaults:
      run:
        working-directory: ${{ env.TF_BOOTSTRAP_DIR }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Authenticate to GCP (OIDC)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}

      - name: Get GKE credentials
        run: |
          gcloud container clusters get-credentials \
            ${{ vars.GKE_CLUSTER_NAME }} \
            --region ${{ vars.GCP_REGION }} \
            --project ${{ vars.GCP_PROJECT_ID }}

      - name: Terraform Init
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=bootstrap" \
            -reconfigure \
            -input=false

      - name: Download plan artifact
        uses: actions/download-artifact@v4
        with:
          name: tfplan-phase-b
          path: ${{ env.TF_BOOTSTRAP_DIR }}

      - name: Terraform Apply
        run: terraform apply -auto-approve tfplan.binary

# =============================================================
# JOB 6 — DESTROY (PROTÉGÉ)
# Manuel uniquement, avec approbation GitHub Environment
# =============================================================
  destroy:
    name: "Destroy Staging"
    runs-on: ubuntu-latest

    if: github.event_name == 'workflow_dispatch' && inputs.action == 'destroy-staging'

    # GitHub Environment avec règle d'approbation obligatoire.
    # Un reviewer doit approuver manuellement avant que
    # le destroy s'exécute. Protège contre les destructions accidentelles.
    environment: staging-destroy

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: ${{ env.TF_VERSION }}

      - name: Authenticate to GCP (OIDC)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.SERVICE_ACCOUNT_EMAIL }}

      - name: Get GKE credentials
        run: |
          gcloud container clusters get-credentials \
            ${{ vars.GKE_CLUSTER_NAME }} \
            --region ${{ vars.GCP_REGION }} \
            --project ${{ vars.GCP_PROJECT_ID }}

      # ── Destroy dans l'ordre inverse des dépendances ──────
      # Phase B d'abord (dépend de Phase A)
      # puis Phase A (l'infrastructure elle-même)
      - name: Destroy Phase B (GitOps)
        working-directory: ${{ env.TF_BOOTSTRAP_DIR }}
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=bootstrap" \
            -reconfigure -input=false
          terraform destroy -auto-approve || true

      - name: Destroy Phase A (Infra)
        working-directory: ${{ env.TF_STAGING_DIR }}
        run: |
          terraform init \
            -backend-config="bucket=${{ vars.GCS_BUCKET_NAME }}" \
            -backend-config="prefix=staging" \
            -reconfigure -input=false
          terraform destroy -auto-approve
